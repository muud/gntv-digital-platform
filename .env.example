# ==============================================================================
# GNTV ENVIRONMENTAL CONFIGURATION CONFIG
# Copy to .env and configure for local fallback or production nodes
# ==============================================================================

# System Node Mode (development / production)
NODE_ENV=development

# 1. PostgreSQL Database Configuration
# Local development: POSTGRES_HOST=localhost
# Docker Compose backend container: POSTGRES_HOST=db
# Production: use your managed PostgreSQL host
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me
POSTGRES_DB=gntv_media_hub
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional host port for Docker Compose's published PostgreSQL port.
# Use a high port such as 55432 if another local PostgreSQL already owns 5432.
POSTGRES_HOST_PORT=5432
# Local/Docker: disable. Managed cloud PostgreSQL: usually require.
POSTGRES_SSL_MODE=disable

# Combined Database URL for ORM Ingress
# Local example:
DATABASE_URL=postgresql://change_me:change_me@localhost:5432/gntv_media_hub?sslmode=disable
# Docker Compose backend overrides this to use host `db`.

# 2. ApsaraDB for Redis Caching Nodes
REDIS_HOST=localhost
REDIS_PORT=6379

# 3. Alibaba Cloud Object Storage Service (OSS) Credentials
# Set STORAGE_MODE to 'oss' to enable Alibaba storage adapters
STORAGE_MODE=local
ALIBABA_CLOUD_ACCESS_KEY_ID=LTAI5tXXXXXX
ALIBABA_CLOUD_ACCESS_KEY_SECRET=XXXXXX
ALIBABA_OSS_ENDPOINT=oss-ap-southeast-1.aliyuncs.com
ALIBABA_OSS_RAW_BUCKET=gntv-raw-uploads
ALIBABA_OSS_HLS_BUCKET=gntv-streaming-media

# CMS Media Library (Module 2)
MEDIA_STORAGE_PROVIDER=local
MEDIA_LOCAL_ROOT=./var/media
MEDIA_PUBLIC_BASE_URL=/media
MEDIA_SIGNING_SECRET=replace_with_a_long_random_secret
MEDIA_MAX_FILE_SIZE=5368709120
MEDIA_URL_TTL_SECONDS=900
# For MEDIA_STORAGE_PROVIDER=oss (never commit real credentials):
OSS_BUCKET_NAME=
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 4. ApsaraVideo Live & CDN Downlink Configuration
ALIBABA_CDN_PLAY_DOMAIN=https://stream.gntv.com
APSARA_INGEST_URL=rtmp://video-center.alivecdn.com/gntv-live
APSARA_PLAY_URL=http://stream.gntv.com/gntv-live
APSARA_STREAM_KEY=auth_key_param

# 5. Production Authentication Security
JWT_SECRET_KEY=gntv_jwt_secret_token_key_phrase_2026_super_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
