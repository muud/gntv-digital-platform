# ==============================================================================
# GNTV DIGITAL Platform — Alibaba Cloud Staging Environment Configuration
# Template File (.env.example) — Populate via Cloud Secret Manager / KMS
# DO NOT COMMIT REAL CREDENTIAL VALUES TO GIT
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME (PUBLIC / INTERNAL CONFIG)
# ------------------------------------------------------------------------------
APP_NAME="GNTV DIGITAL Platform (Staging)"
ENVIRONMENT=staging
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. MANAGED DATABASE (APSARADB RDS FOR POSTGRESQL) [SECRET / INTERNAL]
# ------------------------------------------------------------------------------
# Use private VPC endpoint of ApsaraDB RDS instance (Port 5432)
POSTGRES_HOST=pgm-staging-gntv.pg.rds.aliyuncs.com
POSTGRES_PORT=5432
POSTGRES_DB=gntv_media_hub_staging
POSTGRES_USER=gntv_staging_app
POSTGRES_PASSWORD=replace-with-high-entropy-rds-password
# Full assembled URL (sslmode=require recommended for ApsaraDB)
DATABASE_URL=postgresql://gntv_staging_app:replace-with-high-entropy-rds-password@pgm-staging-gntv.pg.rds.aliyuncs.com:5432/gntv_media_hub_staging?sslmode=require

# ------------------------------------------------------------------------------
# 3. CACHE & EVENT COORDINATION (ALIBABA APSARADB FOR REDIS) [SECRET / INTERNAL]
# ------------------------------------------------------------------------------
REDIS_HOST=r-staging-gntv.redis.rds.aliyuncs.com
REDIS_PORT=6379
REDIS_URL=redis://:replace-with-redis-token@r-staging-gntv.redis.rds.aliyuncs.com:6379/0

# ------------------------------------------------------------------------------
# 4. SECURITY & APPLICATION TOKENS [SECRET]
# ------------------------------------------------------------------------------
# High-entropy signing keys (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=replace-with-at-least-32-byte-hex-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

INGEST_GATEWAY_TOKEN=replace-with-at-least-24-char-ingest-token
PLAYBACK_SIGNING_SECRET=replace-with-at-least-32-char-playback-secret
EMBED_SIGNING_SECRET=replace-with-at-least-32-char-embed-secret
CDN_SIGNING_SECRET=replace-with-at-least-16-char-cdn-secret
MEDIA_SIGNING_SECRET=replace-with-at-least-24-char-media-secret

# ------------------------------------------------------------------------------
# 5. DOMAINS & PUBLIC ENDPOINTS [PUBLIC CONFIG]
# ------------------------------------------------------------------------------
PLAYBACK_PUBLIC_BASE_URL=https://stream-staging.gntvdigital.com
MEDIA_PUBLIC_BASE_URL=/media

# Injected into frontend-studio build:
# VITE_API_URL=https://api-staging.gntvdigital.com

# ------------------------------------------------------------------------------
# 6. OBJECT STORAGE (ALIBABA CLOUD OSS - STAGING BUCKET) [INTERNAL / SECRET]
# ------------------------------------------------------------------------------
# In initial staging validation, set MEDIA_STORAGE_PROVIDER=local or oss
MEDIA_STORAGE_PROVIDER=local
MEDIA_LOCAL_ROOT=/app/var/media
MEDIA_PROCESSING_OUTPUT_ROOT=/app/var/streaming-media
MEDIA_PROCESSING_WORKSPACE_ROOT=/tmp/gntv-transcode

# When attaching to staging OSS bucket:
OSS_BUCKET_NAME=gntv-staging-media
OSS_ENDPOINT=oss-me-central-1-internal.aliyuncs.com
OSS_ACCESS_KEY_ID=replace-with-ram-staging-key-id
OSS_ACCESS_KEY_SECRET=replace-with-ram-staging-key-secret

# ------------------------------------------------------------------------------
# 7. INTEGRATION BOUNDARIES & MOCK CONTROLS (STAGING IMMUTABILITY) [INTERNAL CONFIG]
# ------------------------------------------------------------------------------
# Autopilot publishing adapter remains strictly MOCK in staging (no real social calls)
AUTOPILOT_PUBLISH_MODE=mock

# AI Agent control plane uses mock provider boundary by default
AI_PROVIDER_DEFAULT=mock

# Reliability notifications use internal mock provider
RELIABILITY_NOTIFICATION_PROVIDER=mock
